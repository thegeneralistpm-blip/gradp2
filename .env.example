# Copy this file to .env for local AI screening. Never commit the real .env file.
# For Railway or Render, add the same names in the service's Environment Variables page.

GEMINI_API_KEY=
GROQ_API_KEY=

# Optional free-tier-safe defaults
AI_MAX_REVIEWS_PER_RUN=200
AI_BATCH_SIZE=10
AI_SCOPE=keyword_relevant

